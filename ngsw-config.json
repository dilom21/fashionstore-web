{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/*.json"
        ]
      }
    },
    {
      "name": "public-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/images/**"] }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/tenant/**",
    "!/auth/**",
    "!/saas/**",
    "!/admin/**",
    "!/personal/**",
    "!/carritos/**",
    "!/reservas/**",
    "!/checkout/**",
    "!/pagos/**",
    "!/ventas/**"
  ]
}
