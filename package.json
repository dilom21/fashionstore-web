{
  "name": "fashionstore-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:saas": "ng build --configuration saas-local",
    "start:saas": "ng serve --configuration saas-local",
    "build:saas-unified": "ng build --configuration saas-unified",
    "start:saas-unified": "ng serve --configuration saas-unified",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:fashionstore-web": "node dist/fashionstore-web/server/server.mjs",
    "e2e": "playwright test",
    "e2e:saas": "playwright test --project=saas",
    "e2e:legacy": "playwright test --project=legacy"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.4",
    "@angular/ssr": "^22.1.6",
    "@stripe/stripe-js": "^9.16.0",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
